---
profile: basic

exclude_paths:
  - .github/
  - roles/containers/files/
  - scripts/

skip_list:
  - var-naming[no-role-prefix]   # `<svc>_service` facts and role vars are unprefixed on purpose
  - name[missing]                # import_tasks / include_tasks lines carry no name
  # Workstation tooling (Homebrew, nvm, Neovim) installs through curl and shell
  - command-instead-of-module
  - command-instead-of-shell
  - key-order[task]
