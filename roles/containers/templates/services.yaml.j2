---
- Utilities:
    - Actual:
        icon: actual-budget.png
        href: https://actual.fantaquoggio.bid
        description: Gestisce i sordi
        server: server-docker
        container: actualbudget
        statusStyle: "dot"
        showStats: true

    - Vaultwarden:
        icon: vaultwarden.png
        href: {{ vaultwarden_url }}
        description: Gestore di password e secret
        server: server-docker
        container: vaultwarden
        statusStyle: "dot"
        showStats: true

    - Trilium:
        icon: trilium.png
        href: https://trilium.fantaquoggio.bid
        description: Note taking app
        server: server-docker
        container: trilium
        statusStyle: "dot"
        showStats: true
        widget:
          type: trilium
          url: http://trilium:8080
          key: "{{ trilium_token }}"

    - zerobyte:
        icon: zerobyte.png
        href: http://quoggioserver:4096
        description: backup
        server: server-docker
        container: zerobyte
        statusStyle: "dot"
        showStats: true

    - beszel:
        icon: beszel.png
        href: http://quoggioserver:8090
        description: monitoring
        server: server-docker
        container: beszel
        statusStyle: "dot"
        showStats: true
        widget:
          type: beszel
          url: http://beszel:8090
          username: "{{ beszel_user }}"
          password: "{{ beszel_password }}"
          systemId: "{{ beszel_sid }}"
          version: 2

    - WUD:
        icon: sh-wud.png
        href: http://quoggioserver:3004
        description: Aggiornamenti immagini disponibili
        server: server-docker
        container: wud
        statusStyle: "dot"
        showStats: true
        widget:
          type: whatsupdocker
          url: http://wud:3000

    - qBitTorrent:
        icon: qbittorrent.png
        href: http://quoggioserver:8585
        description: Attento ai pornazzi
        server: server-docker
        container: qbittorrent
        statusStyle: "dot"
        showStats: true
        widget:
          type: qbittorrent
          url: http://qbittorrent:8585
          username: "{{ qb_user }}"
          password: "{{ qb_password }}"
          enableLeechProgress: true
          enableLeechSize: true

    - Spesatracker:
        icon: shopify.png
        href: http://quoggioserver:8400
        description: Mangiare costa caro
        server: server-docker
        container: spesatracker
        statusStyle: "dot"
        showStats: true

    - karutuogg:
        icon: mdi-cards
        href: https://karutuogg.fantaquoggio.bid
        description: Il gioco di carte del tunnel
        server: server-docker
        container: karutuogg-web
        statusStyle: "dot"
        showStats: true

    - FantaQuoggio:
        icon: mdi-soccer
        href: {{ fantaquoggio_url }}
        description: Asta e formazione, con la matematica
        server: server-docker
        container: fantaquoggio
        statusStyle: "dot"
        showStats: true

    - FantaQuoggio Airflow:
        icon: sh-apache-airflow
        href: http://{{ tailscale_ip }}:8420
        description: La pipeline dei Round
        server: server-docker
        container: fantaquoggio-airflow-apiserver
        statusStyle: "dot"
        showStats: true

    - Mealie:
        icon: mealie.png
        href: http://quoggioserver:9925
        description: Pasta al salame?
        server: server-docker
        container: mealie
        statusStyle: "dot"
        showStats: true

