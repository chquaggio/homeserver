        icon: sonarr.png
        href: http://quoggioserver:8989
        description: Scarica serie tv
        server: server-docker
        container: sonarr
        statusStyle: "dot"
        showStats: true
        widget:
          type: sonarr
          url: http://sonarr:8989
          key: "{{ sonarr_key }}"
          enableQueue: true

    - Radarr:
        icon: radarr.png
        href: http://quoggioserver:7878
