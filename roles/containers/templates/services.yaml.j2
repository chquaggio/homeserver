        statusStyle: "dot"
        showStats: true

    - VibraVid:
        icon: mdi-movie-open
        href: http://quoggioserver:8001
        description: Scarica dallo streaming per Sonarr/Radarr
        server: server-docker
        container: vibravid
        statusStyle: "dot"
        showStats: true

- Media:
    - Jellyfin:
        icon: jellyfin.png
        href: https://jellyfin.fantaquoggio.bid
        description: Pezzotto
        server: server-docker
        container: jellyfin
        statusStyle: "dot"
        showStats: true
        widget:
          type: jellyfin
          url: http://jellyfin:8096
          key: "{{ jellyfin_key }}"
          enableBlocks: true
          enableNowPlaying: true
          enableUser: true
          enableMediaControl: false
          showEpisodeNumber: true
          expandOneStreamToTwoRows: false

    - Calibre-Web Automated:
        icon: calibre-web.png
