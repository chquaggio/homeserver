[DEFAULT]
log_level = "INFO"
close_console = true
show_message = true
fetch_domain_online = true
auto_check_update = true
auto_update_binaries = true
disable_scraper_cache = false
imp_service = ["default"]
installation = ""
wvd_dir = ""
prd_dir = ""
metadata_provider = "tmdb,imdb"
tui_images = "auto"

[OUTPUT]
root_path = "Video"
movie_folder_name = "Movie"
serie_folder_name = "Serie"
anime_folder_name = "Anime"
music_folder_name = "Music"
live_folder_name = "Live"
movie_format = "%(title_name) (%(title_year))/%(title_name) (%(title_year))"
episode_format = "%(series_name)/S%(season:02d)/%(episode_name) S%(season:02d)E%(episode:02d)"
song_format = "%(artist)/%(album)/%(track_number:02d). %(title)"
tag_format = "[VibraVid]"

[DOWNLOAD]
skip_download = false
auto_select = true
use_curl_cffi_segments = false
delay_after_download = 0
thread_count = 10
max_speed_mbps = 0
segment_delay_seconds = 0
segment_delay_jitter_seconds = 0
subtitle_resolve_workers = 4
select_video = "best"
select_audio = "lang='ita|eng|Ita|Eng|it|en':for=all"
select_subtitle = "lang='ita|eng|Ita|Eng|it|en':for=all"
extract_embedded_cc = false
live_max_empty_polls = 8
max_token_refresh_rounds = 10
token_refresh_backoff_seconds = 4.0
token_refresh_stall_rounds = 3
embed_poster = false
write_sidecars = false
cleanup_tmp_folder = true

[CODEC]
dv_auto = true

[PROCESS]
engine = "ffmpeg"
use_gpu = false
param_video = ["-c:v", "libx265", "-crf", "28", "-preset", "medium"]
param_audio = ["-c:a", "libopus", "-b:a", "128k"]
param_song = []
param_final = ["-c", "copy"]
audio_order = []
subtitle_order = []
subtitle_disposition_language = "it-it_forced"
merge_audio = true
merge_subtitle = true
force_subtitle = "auto"
mux_dtsx = false
extension = "mkv"

[REQUESTS]
timeout = 15
max_retry = 8
verify = true
use_proxy = false
proxy_scope = "scrap+down"

[REQUESTS.proxy]
http = "http://localhost:8888"
https = "http://localhost:8888"

[DRM]
use_cdm = true
cdm = "search"
bypass_vault_cache = false
log_engine_output = false

[DRM.vault.default]
url = "https://drm-db.server66.workers.dev"
token = ""

[HOOKS]
pre_run = []
pre_download = []
post_download = []
post_run = []

[ARR]
enabled = true
download_italian_anime_default = true
anime_id_crosswalk_enabled = true
provider_fallback = ["streamingcommunity", "animeunity", "discoveryplus", "aurora", "mediasetinfinity", "raiplay", "animeworld", "tubitv"]
{# One id list gates both apps: tag "vibravid" must keep id 2 in Radarr and Sonarr. #}
tags_mode = "WHITELIST"
active_tag_ids = [2]
enable_polling = true
enable_seerr_webhook = false
enable_sonarr_webhook = false
enable_radarr_webhook = false
polling_interval = 86400
full_resync_interval = 86400
max_concurrent_downloads = 2
webhook_priority_enabled = true
native_webhook_priority_window_seconds = 120
seerr_fallback_delay_seconds = 20

[ARR.path_mapping]

[ARR.sonarr]
url = "http://sonarr:8989"
api_key = "{{ sonarr_key }}"

[ARR.radarr]
url = "http://radarr:7878"
api_key = "{{ radarr_key }}"

[ARR.seerr]
webhook_secret = ""

[ARR.sonarr_webhook]
webhook_secret = ""

[ARR.radarr_webhook]
webhook_secret = ""

[TELEGRAM]
enabled = false
gui_url = "http://vibravid:8000"
max_results = 8
